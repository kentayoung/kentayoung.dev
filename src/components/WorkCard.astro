---
const { slug, client, title, summary, stack } = Astro.props;
---

<a
  href={`/work/${slug}`}
  class="block card p-8 border border-transparent hover:border-seafoam transition"
>
  <div class="eyebrow text-seafoam">{client}</div>
  <h3 class="text-xl text-ink font-light pt-1 pb-2">{title}</h3>
  <p class="text-ink/80 leading-5 pb-4">{summary}</p>
  <ul class="flex flex-wrap gap-2">
    {stack.map((item) => (
      <li class="pill">{item}</li>
    ))}
  </ul>
  <div class="pt-4 text-seafoam text-sm">Read the case study &rarr;</div>
</a>
