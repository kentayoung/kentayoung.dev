---
import { more } from "../data/work.js";
---

<h2 class="text-ink/60 eyebrow mt-12 mb-4">Also worked on</h2>
<ul class="grid gap-x-10 gap-y-5 md:grid-cols-2">
  {more.map(({ client, summary }) => (
    <li class="border-l-2 border-seafoam/60 pl-4">
      <div class="text-ink">{client}</div>
      <p class="text-ink/80 text-sm leading-5 pt-1">{summary}</p>
    </li>
  ))}
</ul>
