---
import { icons } from "../data/icons.js";
const { name, class: className } = Astro.props;
const { viewBox, inner } = icons[name];
---

<svg
  stroke="currentColor"
  fill="currentColor"
  stroke-width="0"
  viewBox={viewBox}
  class={className}
  height="1em"
  width="1em"
  aria-hidden="true"
  set:html={inner}
/>
