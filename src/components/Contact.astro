---
import Icon from "./Icon.astro";
---

<section
  id="contact"
  class="flex justify-center flex-wrap pt-5 pb-2.5 w-[calc(100vw-110px)] max-w-245 mx-auto max-[900px]:w-[calc(100vw-40px)] max-[900px]:flex-col max-[900px]:items-center"
>
  <div class="gap-6 flex min-[900px]:flex-row flex-col items-center">
    <div class="bg-[#262b20] rounded-[10px] w-[28vw] min-w-50 text-center p-10 max-w-75 max-[900px]:w-[90vw] max-[900px]:max-w-125">
      <Icon name="location" class="h-5 w-5 mx-auto text-seafoam" />
      <h4 class="font-normal uppercase text-[0.8rem] tracking-[0.15rem] text-text-light mt-1">Location</h4>
      <hr class="border-seafoam border-2 w-12 mx-auto my-6" />
      <div class="text-[80%] text-text-light">SW Idaho</div>
    </div>
    <div class="bg-[#262b20] rounded-[10px] w-[28vw] min-w-50 text-center p-10 max-w-75 max-[900px]:w-[90vw] max-[900px]:max-w-125">
      <Icon name="email" class="h-5 w-5 mx-auto text-seafoam" />
      <h4 class="font-normal uppercase text-[0.8rem] tracking-[0.15rem] text-text-light mt-1">Email</h4>
      <hr class="border-seafoam border-2 w-12 mx-auto my-6" />
      <div class="text-[80%] text-text-light">
        <a href="mailto:kenta@kentayoung.dev" class="link-hover text-text-light">Kenta@KentaYoung.dev</a>
      </div>
    </div>
  </div>
</section>
