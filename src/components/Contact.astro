---
import Icon from "./Icon.astro";

const cards = [
  { icon: "email", title: "Email", text: "Kenta@KentaYoung.dev", href: "mailto:kenta@kentayoung.dev" },
  { icon: "linkedin", title: "LinkedIn", text: "linkedin.com/in/kentayoung", href: "https://www.linkedin.com/in/kentayoung" },
  { icon: "github", title: "GitHub", text: "github.com/kentayoung", href: "https://github.com/kentayoung" },
  { icon: "location", title: "Location", text: "Idaho" },
];
---

<section
  id="contact"
  class="container-page pb-section"
>
  <h2 class="section-title">
    Contact
  </h2>
  <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
    {cards.map(({ icon, title, text, href }) => {
      const Tag = href ? "a" : "div";
      const external = href?.startsWith("http");
      return (
        <Tag
          href={href}
          target={external ? "_blank" : undefined}
          rel={external ? "noreferrer" : undefined}
          class:list={[
            "group flex min-w-0 items-center gap-4 card border border-line p-6 transition",
            href && "hover:border-seafoam hover:bg-surface-hover",
          ]}
        >
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-seafoam text-dark">
            <Icon name={icon} class="h-5 w-5" />
          </span>
          <span class="min-w-0">
            <span class="block eyebrow text-ink/60">{title}</span>
            <span class="block break-words text-ink" set:html={text.replaceAll("/", "/<wbr>").replaceAll("@", "@<wbr>")} />
          </span>
          {href && (
            <span class="ml-auto pl-2 text-seafoam max-sm:hidden opacity-60 transition group-hover:translate-x-1 group-hover:opacity-100" aria-hidden="true">
              &rarr;
            </span>
          )}
        </Tag>
      );
    })}
  </div>
</section>
