---
const interests = [
  {
    topic: "AI agents & Hermes Agent",
    description: "Finding an agent setup where I can choose providers and models, keep more consistent memory, and get better results.",
  },
  {
    topic: "AI-assisted engineering",
    description: "How AI changes the way I design, build, and test software, and where my own judgment matters most.",
  },
  {
    topic: "Home server",
    description: "Giving an old gaming PC a second life as an always-on home for self-hosted tools, AI agents, and local LLMs.",
  },
  {
    topic: "Automation",
    description: "Connecting tools and scripting the repetitive stuff so I can spend more time on interesting problems.",
  },
];
---

<section id="curious" aria-labelledby="curious-title" class="container-page py-section text-ink">
  <h2 id="curious-title" class="section-title">What I'm curious about</h2>
  <p class="curious-intro">A few things that have my attention lately.</p>
  <dl class="curious-list">
    {interests.map(({ topic, description }) => (
      <div class="curious-row">
        <dt>{topic}</dt>
        <dd>{description}</dd>
      </div>
    ))}
  </dl>
</section>

<style>
  .curious-intro {
    margin-bottom: 1.75rem;
    line-height: 1.6;
  }

  .curious-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 0.5rem 2rem;
    padding-block: 1.125rem;
    border-top: 1px solid var(--color-line);
  }

  .curious-row:last-child {
    border-bottom: 1px solid var(--color-line);
  }

  dt {
    color: var(--color-seafoam);
    font-weight: 400;
    line-height: 1.6;
  }

  dd {
    line-height: 1.6;
    text-wrap: pretty;
  }

  @media (width < 900px) {
    .curious-row {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
