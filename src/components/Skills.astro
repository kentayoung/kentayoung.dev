---
const skills = [
  { title: "Shopify", items: ["Online Store 2.0", "Liquid", "Shopify Plus", "Metafields and metaobjects", "Shopify Flow", "Checkout and customer accounts"] },
  { title: "Ecommerce", items: ["Recharge subscriptions", "Intelligems A/B testing", "Klaviyo", "Gorgias", "Catalog migrations"] },
  { title: "Analytics and Integrations", items: ["Segment", "GA4", "Littledata", "HubSpot"] },
  { title: "Frontend", items: ["JavaScript", "TypeScript", "React", "Vue", "AngularJS", "Next.js", "HTML", "CSS/SCSS", "Tailwind CSS", "Vite"] },
  { title: "CMS and Quality", items: ["Sanity CMS", "Storybook", "Testing Library", "Accessibility (ARIA)", "Structured data (JSON-LD)", "SEO"] },
  { title: "Engineering", items: ["Technical leadership", "Architecture", "Code review", "Git and GitHub Actions", "CI/CD"] },
];
---

<section
  id="skills"
  class="container-page pb-section"
>
  <h2 class="section-title">
    Skills
  </h2>
  {skills.map(({ title, items }) => (
    <div class="my-4">
      <h3 class="text-ink/60 eyebrow mb-2">{title}</h3>
      <ul class="flex flex-wrap gap-2">
        {items.map((item) => (
          <li class="pill pill-filled">{item}</li>
        ))}
      </ul>
    </div>
  ))}
</section>
