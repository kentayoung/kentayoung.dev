---
import Icon from "./Icon.astro";
const links = [
  { id: "linkedIn-KentaYoung", href: "https://www.linkedin.com/in/kentayoung", icon: "linkedin", label: "LinkedIn" },
  { id: "instagram-KentaYoung", href: "https://instagram.com/kenta_young", icon: "instagram", label: "Instagram" },
  { id: "facebook-KentaYoung", href: "https://www.facebook.com/kentayoungphotography", icon: "facebook", label: "Facebook" },
  { id: "github-KentaYoung", href: "https://github.com/kentayoung", icon: "github", label: "GitHub" },
];
---

<footer class="flex justify-center py-6">
  {links.map(({ id, href, icon, label }) => (
    <a id={id} href={href} target="_blank" rel="noreferrer" class="icon-circle" aria-label={label}>
      <Icon name={icon} />
    </a>
  ))}
</footer>
