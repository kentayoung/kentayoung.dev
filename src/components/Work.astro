---
const projects = [
  {
    slug: "needed",
    client: "Needed",
    title: "Custom subscription commerce",
    summary:
      "Rebuilt subscription purchasing on Shopify and Recharge, from variant-based products to custom selectors and cart upsells.",
    stack: ["Shopify", "Liquid", "JavaScript", "Recharge"],
  },
];
---

<section
  id="work"
  class="w-[calc(100vw-110px)] max-w-245 mx-auto pb-17.5 max-[900px]:w-[calc(100vw-40px)]"
>
  <h2 class="text-[calc(1.325rem+0.9vw)] text-text-light font-light pb-2.5 tracking-[0.25rem]">
    Selected Work
  </h2>
  <div class="grid gap-6">
    {projects.map(({ slug, client, title, summary, stack }) => (
      <a
        href={`/work/${slug}`}
        class="block bg-[#262b20] rounded-[10px] p-8 border border-transparent hover:border-seafoam transition"
      >
        <div class="text-[0.8rem] uppercase tracking-[0.15rem] text-seafoam">{client}</div>
        <h3 class="text-xl text-text-light font-light pt-1 pb-2">{title}</h3>
        <p class="text-text-light/80 leading-5 pb-4">{summary}</p>
        <ul class="flex flex-wrap gap-2">
          {stack.map((item) => (
            <li class="border border-[#3a3f2e] text-text-light text-sm px-3 py-1 rounded-full">{item}</li>
          ))}
        </ul>
        <div class="pt-4 text-seafoam text-sm">Read the case study &rarr;</div>
      </a>
    ))}
  </div>
</section>
