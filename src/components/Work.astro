---
import WorkCard from "./WorkCard.astro";
import { projects } from "../data/work.js";
---

<section
  id="work"
  class="w-[calc(100vw-110px)] max-w-245 mx-auto pb-17.5 max-[900px]:w-[calc(100vw-40px)]"
>
  <h2 class="text-[calc(1.325rem+0.9vw)] text-text-light font-light pb-2.5 tracking-[0.25rem]">
    Selected Work
  </h2>
  <div class="grid gap-6">
    {projects.map((project) => <WorkCard {...project} />)}
  </div>
  <a href="/work" class="link-hover-seafoam mt-8 inline-block">See all work and more projects &rarr;</a>
</section>
