---
import "@fontsource/montserrat/300.css";
import "@fontsource/montserrat/400.css";
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";

const {
  title = "Kenta Young | Software Engineer",
  description = "Kenta Young is a Software Engineer and Photographer in Idaho with 10+ years of experience building web applications and Shopify storefronts.",
  path = "/",
  breadcrumbs = [],
} = Astro.props;
const url = new URL(path, Astro.site).href;
const image = new URL("/og-image.jpg", Astro.site).href;
const imageAlt = "Kenta Young, Software Engineer and Photographer";
const person = {
  "@type": "Person",
  "@id": "https://kentayoung.dev/#person",
  name: "Kenta Young",
  url: "https://kentayoung.dev",
  jobTitle: "Software Engineer",
  description:
    "Software Engineer and Photographer based in Idaho with over a decade of experience building web applications, Shopify storefronts and polished user experiences.",
  knowsAbout: ["Shopify", "React", "TypeScript", "Ecommerce", "Web accessibility", "Photography"],
  alumniOf: { "@type": "CollegeOrUniversity", name: "Regis University" },
  address: { "@type": "PostalAddress", addressRegion: "ID", addressCountry: "US" },
  sameAs: [
    "https://github.com/kentayoung",
    "https://www.linkedin.com/in/kentayoung",
    "https://www.instagram.com/kenta_young/",
  ],
};
const website = {
  "@type": "WebSite",
  "@id": "https://kentayoung.dev/#website",
  name: "Kenta Young",
  url: "https://kentayoung.dev",
  author: { "@id": "https://kentayoung.dev/#person" },
};
const crumbs = breadcrumbs.length
  ? {
      "@type": "BreadcrumbList",
      itemListElement: breadcrumbs.map((crumb, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: crumb.name,
        item: new URL(crumb.path, Astro.site).href,
      })),
    }
  : null;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [person, website, crumbs].filter(Boolean),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Kenta Young" />
    <link rel="canonical" href={url} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:site_name" content="Kenta Young" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <slot name="head" />

    {import.meta.env.PROD && (
      <script is:inline>
        if (["kentayoung.dev", "www.kentayoung.dev"].includes(location.hostname)) {
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () { dataLayer.push(arguments); };
          gtag("js", new Date());
          gtag("config", "G-FPRPFKVS3C");
          var ga = document.createElement("script");
          ga.async = true;
          ga.src = "https://www.googletagmanager.com/gtag/js?id=G-FPRPFKVS3C";
          document.head.appendChild(ga);
        }
      </script>
    )}
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-1000 focus:rounded-full focus:bg-seafoam focus:px-4 focus:py-2 focus:text-sm focus:text-dark"
    >
      Skip to content
    </a>
    <Navbar />
    <main id="main" tabindex="-1" class="page-in outline-none">
      <slot />
    </main>
  </body>
</html>
