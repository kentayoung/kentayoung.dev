---
import Base from "./Base.astro";
import Footer from "../components/Footer.astro";

const { client, tagline, description, path, stack, built, challenges } = Astro.props;
const label = "text-[0.8rem] uppercase tracking-[0.15rem] text-text-light/60";
---

<Base
  title={`${client} Case Study | Kenta Young`}
  description={description}
  path={path}
>
  <div class="min-h-[calc(100vh-150px)] mt-16">
    <article class="w-[calc(100vw-110px)] max-w-245 mx-auto py-17.5 max-[900px]:w-[calc(100vw-40px)] text-text-light">
      <a href="/#work" class="link-hover-seafoam text-sm">&larr; Selected work</a>
      <h1 class="text-[calc(1.325rem+0.9vw)] font-light pt-6 pb-2.5 tracking-[0.25rem]">{client}</h1>
      <p class="text-lg text-text-light/80 pb-6">{tagline}</p>
      <ul class="flex flex-wrap gap-2 pb-10">
        {stack.map((item) => (
          <li class="border border-[#3a3f2e] bg-[#262b20] text-sm px-3 py-1 rounded-full">{item}</li>
        ))}
      </ul>

      <h2 class={`${label} pb-2`}>Overview</h2>
      <p class="leading-6 pb-10"><slot /></p>

      <h2 class={`${label} pb-2`}>What I built</h2>
      <ul class="list-disc pl-5 leading-6 pb-10 space-y-2 marker:text-seafoam">
        {built.map((item) => <li>{item}</li>)}
      </ul>

      <h2 class={`${label} pb-4`}>Technical challenges</h2>
      <div class="grid gap-6 md:grid-cols-3">
        {challenges.map(({ title, body }) => (
          <div class="bg-[#262b20] rounded-[10px] p-6">
            <h3 class="text-base pb-2">{title}</h3>
            <p class="text-sm leading-5 text-text-light/80">{body}</p>
          </div>
        ))}
      </div>
    </article>
  </div>
  <Footer />
</Base>
