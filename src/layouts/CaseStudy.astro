---
import { Image } from "astro:assets";
import Base from "./Base.astro";
import Footer from "../components/Footer.astro";

const { client, seoTitle, tagline, description, path, stack, built, challenges, screens = [] } = Astro.props;
const label = "eyebrow text-ink/60";
const breadcrumbs = [
  { name: "Home", path: "/" },
  { name: "Work", path: "/work" },
  { name: client, path },
];
---

<Base
  title={seoTitle ?? `${client} Case Study | Kenta Young`}
  description={description}
  path={path}
  breadcrumbs={breadcrumbs}
>
  <div class="min-h-[calc(100vh-150px)] mt-nav">
    <article class="container-page py-section text-ink">
      <a href="/work" class="link-hover-seafoam text-sm">&larr; All work</a>
      <h1 class="section-title pt-6">{client}</h1>
      <p class="text-lg text-ink/80 pb-6">{tagline}</p>
      <ul class="flex flex-wrap gap-2 pb-10">
        {stack.map((item) => (
          <li class="pill pill-filled">{item}</li>
        ))}
      </ul>

      <h2 class={`${label} pb-2`}>Overview</h2>
      <p class="leading-6 pb-10"><slot /></p>

      <h2 class={`${label} pb-2`}>What I built</h2>
      <ul class="list-disc pl-5 leading-6 pb-10 space-y-2 marker:text-seafoam">
        {built.map((item) => <li>{item}</li>)}
      </ul>

      {screens.length > 0 && (
        <>
          <h2 class={`${label} pb-2`}>What it looks like</h2>
          <p class="text-sm text-ink/60 pb-4">Screenshots from the live site, captured in October 2026.</p>
          <div class="screens grid gap-6 pb-10" data-screens>
            <div role="tablist" aria-label="Screenshots" data-screens-nav class="flex flex-wrap gap-2">
              {screens.map(({ tab }, i) => (
                <button
                  type="button"
                  role="tab"
                  id={`screen-tab-${i}`}
                  aria-controls={`screen-panel-${i}`}
                  aria-selected={i === 0 ? "true" : "false"}
                  tabindex={i === 0 ? 0 : -1}
                  class="pill inline-flex min-h-11 cursor-pointer items-center transition hover:border-seafoam aria-selected:border-seafoam aria-selected:bg-seafoam aria-selected:text-dark"
                >
                  {tab}
                </button>
              ))}
            </div>
            {screens.map(({ image, alt, caption }, i) => (
              <figure data-screen id={`screen-panel-${i}`} hidden={i > 0}>
                <Image
                  src={image}
                  alt={alt}
                  widths={[640, 960, 1440]}
                  sizes="(min-width: 1024px) 980px, 100vw"
                  class="h-auto w-full rounded-card border border-line"
                />
                <figcaption class="pt-2 text-center text-sm leading-5 text-ink/60">{caption}</figcaption>
              </figure>
            ))}
          </div>
          <noscript>
            <style is:inline>
              [data-screen] {
                display: block !important;
              }
              [data-screens-nav] {
                display: none !important;
              }
            </style>
          </noscript>
        </>
      )}

      <h2 class={`${label} pb-4`}>Technical challenges</h2>
      <div class="grid gap-6 md:grid-cols-3">
        {challenges.map(({ title, body }) => (
          <div class="card p-6">
            <h3 class="text-base pb-2">{title}</h3>
            <p class="text-sm leading-5 text-ink/80">{body}</p>
          </div>
        ))}
      </div>
    </article>
  </div>
  <Footer />
</Base>

<script>
  document.querySelectorAll("[data-screens]").forEach((root) => {
    const nav = root.querySelector("[data-screens-nav]");
    const tabs = [...nav.querySelectorAll("[role=tab]")];
    const panels = [...root.querySelectorAll("[data-screen]")];

    const select = (index) => {
      tabs.forEach((tab, i) => {
        tab.setAttribute("aria-selected", String(i === index));
        tab.tabIndex = i === index ? 0 : -1;
      });
      panels.forEach((panel, i) => {
        panel.hidden = i !== index;
      });
    };

    panels.forEach((panel, i) => {
      panel.setAttribute("role", "tabpanel");
      panel.setAttribute("aria-labelledby", tabs[i].id);
      panel.querySelector("img").loading = "eager";
    });

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => select(i));
      tab.addEventListener("keydown", (e) => {
        const next = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 }[e.key];
        if (next === undefined) return;
        e.preventDefault();
        const target = (next + tabs.length) % tabs.length;
        select(target);
        tabs[target].focus();
      });
    });

    select(0);
  });
</script>
