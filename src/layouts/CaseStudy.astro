---
import Base from "./Base.astro";
import Footer from "../components/Footer.astro";

const { client, tagline, description, path, stack, built, challenges } = Astro.props;
const label = "eyebrow text-ink/60";
---

<Base
  title={`${client} Case Study | Kenta Young`}
  description={description}
  path={path}
>
  <div class="min-h-[calc(100vh-150px)] mt-nav">
    <article class="container-page py-section text-ink">
      <a href="/work" class="link-hover-seafoam text-sm">&larr; All work</a>
      <h1 class="section-title pt-6">{client}</h1>
      <p class="text-lg text-ink/80 pb-6">{tagline}</p>
      <ul class="flex flex-wrap gap-2 pb-10">
        {stack.map((item) => (
          <li class="pill pill-filled">{item}</li>
        ))}
      </ul>

      <h2 class={`${label} pb-2`}>Overview</h2>
      <p class="leading-6 pb-10"><slot /></p>

      <h2 class={`${label} pb-2`}>What I built</h2>
      <ul class="list-disc pl-5 leading-6 pb-10 space-y-2 marker:text-seafoam">
        {built.map((item) => <li>{item}</li>)}
      </ul>

      <h2 class={`${label} pb-4`}>Technical challenges</h2>
      <div class="grid gap-6 md:grid-cols-3">
        {challenges.map(({ title, body }) => (
          <div class="card p-6">
            <h3 class="text-base pb-2">{title}</h3>
            <p class="text-sm leading-5 text-ink/80">{body}</p>
          </div>
        ))}
      </div>
    </article>
  </div>
  <Footer />
</Base>
