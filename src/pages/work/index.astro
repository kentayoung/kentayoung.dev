---
import Base from "../../layouts/Base.astro";
import Footer from "../../components/Footer.astro";
import WorkCard from "../../components/WorkCard.astro";
import MoreWork from "../../components/MoreWork.astro";
import { projects } from "../../data/work.js";
---

<Base
  title="Work and Case Studies | Kenta Young"
  description="Case studies and projects by Kenta Young, including subscription commerce, configurable page modules, and a Shopify storefront build."
  path="/work"
  breadcrumbs={[
    { name: "Home", path: "/" },
    { name: "Work", path: "/work" },
  ]}
>
  <div class="min-h-[calc(100vh-150px)] mt-nav pt-8">
    <section class="container-page pb-section">
      <h1 class="section-title">Work</h1>
      <p class="text-ink/80 pb-8">Selected case studies, plus other projects I've worked on.</p>
      <div class="grid gap-6">
        {projects.map((project) => <WorkCard {...project} />)}
      </div>
      <MoreWork />
    </section>
  </div>
  <Footer />
</Base>
