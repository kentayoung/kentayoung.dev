---
import CaseStudy from "../../layouts/CaseStudy.astro";

const stack = ["Shopify", "Liquid", "JavaScript", "Recharge", "Metafields"];
const built = [
  "Consolidated separate subscription listings into single variant-based Shopify products, with a variant for each delivery schedule.",
  "Set up Recharge selling plans with different billing intervals on those variants.",
  "Built custom product page interactions and purchase selectors for choosing a variant and a subscription plan.",
  "Updated collection quick-add so it handles the new product structure.",
  "Reworked cart interstitials, subscription handling, and upsell flows to match.",
];
const challenges = [
  { title: "Migrating without breaking existing products", body: "Products that had already been migrated needed to keep behaving sensibly, so the cart messaging and product card logic included fallback behavior for them." },
  { title: "Accessible selection", body: "Choosing a variant and a selling plan are two linked decisions. I built the selectors so they work with a keyboard and screen readers, not just a mouse." },
  { title: "Shared state across product and cart", body: "The product page, quick-add, and cart all react to the same purchase choices, so I managed JavaScript events and UI state carefully to keep them in sync." },
];
---

<CaseStudy
  client="Needed"
  tagline="Custom subscription purchasing on Shopify and Recharge."
  description="Case study: rebuilding subscription purchasing for Needed on Shopify and Recharge, with variant-based products, custom selectors, and cart upsells."
  path="/work/needed"
  stack={stack}
  built={built}
  challenges={challenges}
>
  <a href="https://thisisneeded.com" class="link-hover-seafoam" target="_blank" rel="noreferrer">Needed</a>{" "}
  sells subscription products, and each delivery schedule used to be its own product listing. I worked on moving those into variant-based Shopify products backed by Recharge selling plans, then updated everything that touches a purchase: the product page, collection quick-add, the cart, upsells, and interstitials. I did this as a Senior Software Developer at{" "}
  <a href="https://thebeyondgroup.com/" class="link-hover-seafoam" target="_blank" rel="noreferrer">The Beyond Group</a>.
</CaseStudy>
