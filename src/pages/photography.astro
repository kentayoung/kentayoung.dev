---
import Base from "../layouts/Base.astro";
import Footer from "../components/Footer.astro";
import { AutomotiveImages, TravelImages } from "../data/images.js";

const galleries = [
  { title: "Automotive", images: AutomotiveImages, top: "mb-4" },
  { title: "Travel", images: TravelImages, top: "mt-8 mb-4" },
];
---

<Base
  title="Kenta Young | Photography"
  description="Photography by Kenta Young, landscape, nature, and travel photos captured in Idaho and beyond."
  path="/photography"
>
  <div class="min-h-[calc(100vh-150px)] mt-nav pt-8">
    <section class="container-wide">
      <h2 class="section-title">Photography</h2>
      <div class="flex flex-col max-w-full">
        {galleries.map(({ title, images, top }) => (
          <>
            <h2 class={`text-[calc(1rem+0.5vw)] tracking-[0.4rem] font-light text-ink ${top}`}>{title}</h2>
            <ul class="flex flex-wrap gap-1 p-0 m-0 list-none">
              {images.map(({ thumbSrc, alt, width, height }) => (
                <li
                  style={`--r:${width / height}`}
                  class="w-full sm:grow-(--r) sm:basis-[calc(var(--r)*360px)] aspect-(--r)"
                >
                  <img src={thumbSrc} alt={alt} width={width} height={height} loading="lazy" decoding="async" class="w-full h-full block" />
                </li>
              ))}
              <li style="flex-grow:999;flex-basis:0"></li>
            </ul>
          </>
        ))}
      </div>
    </section>
  </div>
  <Footer />
</Base>
